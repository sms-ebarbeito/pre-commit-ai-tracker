#!/usr/bin/env bash
# Appends the AI authorship bar to the commit message.
# Reads stats from .git/ai/stats.tmp written by pre-commit (via build-authorship.py).

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"

[ "$COMMIT_SOURCE" = "merge" ]  && exit 0
[ "$COMMIT_SOURCE" = "squash" ] && exit 0

REPO_ROOT=$(git rev-parse --show-toplevel)
STATS_FILE="$REPO_ROOT/.git/ai/stats.tmp"

[ -f "$STATS_FILE" ] || exit 0

# shellcheck source=/dev/null
source "$STATS_FILE"

cat >> "$COMMIT_MSG_FILE" <<EOF


─────────────────────────────────────────────
Authorship ($ADDED_LINES added, $DELETED_LINES removed)
${AI_BAR}${HUMAN_BAR}${UNATTRIBUTED_BAR}
AI ${AI_PCT}%   Human ${HUMAN_PCT}%   Unattributed ${UNATTRIBUTED_PCT}%
─────────────────────────────────────────────
EOF

exit 0
