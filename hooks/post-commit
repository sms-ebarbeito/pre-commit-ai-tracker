#!/usr/bin/env bash
# Global post-commit hook: attaches the AI Authorship Log as a Git Note.
# Cleans up working checkpoints after the commit.

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
AI_DIR="$REPO_ROOT/.git/ai"
PENDING_LOG="$AI_DIR/pending.log"
WORKING_DIR="$AI_DIR/working"

if [ -f "$PENDING_LOG" ]; then
    git notes --ref=refs/notes/ai add -f -F "$PENDING_LOG" HEAD 2>/dev/null || true
    rm -f "$PENDING_LOG"
fi

# Archive session checkpoints under the commit SHA
if [ -d "$WORKING_DIR" ] && compgen -G "$WORKING_DIR/*.json" > /dev/null 2>&1; then
    COMMIT_SHA=$(git rev-parse --short HEAD)
    ARCHIVE_DIR="$AI_DIR/archive/$COMMIT_SHA"
    mkdir -p "$ARCHIVE_DIR"
    mv "$WORKING_DIR"/*.json "$ARCHIVE_DIR/" 2>/dev/null || true
fi

# Chain to project-level post-commit if it exists
PROJECT_HOOK="$REPO_ROOT/.git/hooks/post-commit"
if [ -x "$PROJECT_HOOK" ]; then
    exec "$PROJECT_HOOK" "$@"
fi

exit 0
