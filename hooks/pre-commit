#!/usr/bin/env bash
# Global pre-commit hook: builds the AI Authorship Log from Claude's edit checkpoints.
# The log is saved to .git/ai/pending.log and attached as a Git Note by post-commit.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

python3 "$SCRIPT_DIR/../scripts/build-authorship.py"

# Chain to project-level pre-commit if it exists
REPO_ROOT=$(git rev-parse --show-toplevel)
PROJECT_HOOK="$REPO_ROOT/.git/hooks/pre-commit"
if [ -x "$PROJECT_HOOK" ]; then
    exec "$PROJECT_HOOK" "$@"
fi

exit 0
